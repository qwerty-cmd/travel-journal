# Copy to .env for local dev. Real values (prod or personal) never get committed.

# --- Database (data/ module) ---
# Local: matches the postgres service in docker-compose.yml
# Prod: Neon connection string
DATABASE_URL=postgresql://bike_trip:bike_trip@localhost:5432/bike_trip

# --- Object storage (storage/ module) — S3-compatible, same client either way ---
# Local: matches the minio service in docker-compose.yml
# Prod: Cloudflare R2 endpoint + credentials
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=bike-trip-photos
S3_REGION=auto

# --- OneDrive archive sync (Microsoft Graph) — your account only ---
# Never committed. Populated after the one-time OAuth consent in Week 1.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_REFRESH_TOKEN=
GRAPH_ONEDRIVE_FOLDER=/BikeTrip2026

# --- App ---
# Comma-separated list of trip rider/viewer slugs is NOT stored here — slugs live in Postgres.
ENVIRONMENT=local
