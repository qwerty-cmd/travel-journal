# Build context exclusions. Mirrors .gitignore: nothing secret, and nothing
# host-shaped, may enter an image layer.

# Secrets — `COPY backend/ ./backend/` would otherwise bake .env into a layer
**/.env
**/.env.local
**/*.key
**/graph_token.json

# Python — host venvs are Windows-shaped (Scripts/, no bin/) and would land on
# top of the Linux venv that `uv sync` builds, breaking the uvicorn CMD
**/.venv*
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache

# Node / frontend — node_modules is installed fresh by `npm ci`; dist is built
# in the frontend-build stage and arrives via COPY --from, which .dockerignore
# does not affect
**/node_modules
frontend/dist
frontend/.vite
# Host-generated build inputs (gitignored). The frontend-build stage must see a
# clean checkout: the TanStack Router vite plugin regenerates routeTree.gen.ts
# during `vite build`, so a stale host copy would only mask a missing-file
# failure in any step that reads src/ before the build. See t-dockerignore-route-tree.
frontend/src/routeTree.gen.ts
**/tsconfig.tsbuildinfo

# Local service data
minio-data/
postgres-data/

# Repo / tooling — not needed to build or run
.git
.gitignore
.claude
